# Шаблон локального файла .env. Скопируйте его в .env и заполните значения.
# Сам .env находится в .gitignore и в репозиторий не попадает.

# Договор и пароль от личного кабинета dom.ufanet.ru (только чтение данных).
UFANET_CONTRACT=
UFANET_PASSWORD=

# Home Assistant: адрес без слэша в конце и долгоживущий токен доступа.
HA_URL=https://homeassistant.local:8123
HA_TOKEN=

# 0 — не проверять сертификат локального Home Assistant (обычно он самоподписанный).
HA_VERIFY_SSL=0
